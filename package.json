{
  "name": "md-annotate",
  "displayName": "MD Annotate",
  "description": "Non-invasive markdown annotation system — add comments and notes via companion metadata files without modifying the original markdown.",
  "version": "0.2.0",
  "publisher": "md-annotate",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mdAnnotate.openAnnotationView",
        "title": "批注模式",
        "icon": "$(comment-discussion)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == markdown",
          "command": "mdAnnotate.openAnnotationView",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "mdAnnotate.annotationEditor",
        "displayName": "MD Annotate",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "markdown-it": "^14.1.1"
  }
}
