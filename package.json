{
  "name": "md-annotate",
  "displayName": "MD Annotate",
  "description": "Non-invasive markdown annotation system — add comments and notes via companion metadata files without modifying the original markdown.",
  "version": "1.0.0",
  "publisher": "XiaoLinXiaoZhu",
  "repository": {
    "type": "git",
    "url": "https://github.com/XiaoLinXiaoZhu/md-annotate"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onLanguage:markdown"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mdAnnotate.openAnnotationView",
        "title": "打开批注模式",
        "icon": "$(comment-discussion)",
        "category": "MD Annotate"
      },
      {
        "command": "mdAnnotate.addAnnotation",
        "title": "添加批注",
        "icon": "$(add)",
        "category": "MD Annotate"
      },
      {
        "command": "mdAnnotate.removeAnnotation",
        "title": "删除批注",
        "category": "MD Annotate"
      },
      {
        "command": "mdAnnotate.toggleResolved",
        "title": "切换批注解决状态",
        "category": "MD Annotate"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == markdown",
          "command": "mdAnnotate.openAnnotationView",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "when": "resourceLangId == markdown && editorHasSelection",
          "command": "mdAnnotate.addAnnotation",
          "group": "mdAnnotate@1"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "mdAnnotate.annotationEditor",
        "displayName": "MD Annotate Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "mdAnnotate.annotationPanel",
          "name": "Annotations",
          "when": "resourceLangId == markdown"
        }
      ]
    },
    "configuration": {
      "title": "MD Annotate",
      "properties": {
        "mdAnnotate.metadataLocation": {
          "type": "string",
          "enum": ["same-directory", ".annotations"],
          "default": "same-directory",
          "description": "Where to store annotation metadata files. 'same-directory' places them next to the markdown file, '.annotations' places them in a subdirectory."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
